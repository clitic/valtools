import { Colors } from "../theme.slint";

export component SkinCard inherits Rectangle {
    in property <string> name;
    in property <int> cost;
    in property <image> icon;

    horizontal-stretch: 1;
    border-radius: 6px;
    background: Colors.card;
    clip: true;

    VerticalLayout {
        Rectangle {
            height: 80px;
            background: #141e2b;

            Image {
                source: root.icon;
                width: parent.width - 16px;
                height: parent.height - 12px;
                x: 8px;
                y: 6px;
                image-fit: contain;
            }
        }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 6px;
            padding-bottom: 6px;

            Text {
                text: root.name;
                color: Colors.text-primary;
                font-size: 10px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            Text {
                text: root.cost + " VP";
                color: #E8D44D;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}
