import { Colors } from "../theme.slint";

export component StatusNotification inherits Rectangle {
    in property <string> message: "Ready";
    in property <bool> is-error: false;

    height: 32px;
    border-radius: 4px;
    background: Colors.panel;
    clip: true;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 8px;

        // Error chip
        if root.is-error: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Rectangle {
                width: 46px;
                height: 18px;
                border-radius: 3px;
                background: #3A1520;

                Text {
                    text: "ERROR";
                    color: Colors.danger;
                    font-size: 9px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    letter-spacing: 0.5px;
                }
            }
        }

        // OK chip
        if !root.is-error: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Rectangle {
                width: 28px;
                height: 18px;
                border-radius: 3px;
                background: #1A3A2A;

                Text {
                    text: "OK";
                    color: Colors.active-dot;
                    font-size: 9px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    letter-spacing: 0.5px;
                }
            }
        }

        Text {
            text: root.message;
            color: Colors.text-secondary;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
