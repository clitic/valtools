import { Colors } from "theme.slint";
import { VButton } from "components/button.slint";
import { Sidebar } from "components/sidebar.slint";
import { TitleBar } from "components/title_bar.slint";
import { AccountsPage } from "pages/accounts.slint";
import { CachePage } from "pages/cache.slint";
import { ShopPage } from "pages/shop.slint";
import { AboutPage } from "pages/about.slint";
export { AccountData, CacheEntryData, ShopResultData } from "data.slint";
import { AccountData, CacheEntryData, ShopResultData } from "data.slint";


export component AppWindow inherits Window {
    title: "ValTools";
    icon: @image-url("icons/logo.png");
    no-frame: true;
    preferred-width: 620px;
    preferred-height: 520px;
    default-font-size: 13px;
    background: Colors.bg;

    in-out property <string> current-page: "accounts";

    in-out property <[AccountData]> accounts: [];
    in-out property <string> status-message: "Ready";
    in-out property <bool> status-is-error: false;

    in-out property <[CacheEntryData]> cache-entries: [];
    in-out property <string> cache-size-display: "size is being calculated...";
    in-out property <string> cache-status: "Ready";
    in-out property <bool> cache-is-error: false;

    in-out property <[string]> shop-account-labels: [];
    in-out property <int> shop-selected-index: 0;
    in-out property <bool> shop-download-images: true;
    in-out property <[ShopResultData]> shop-results: [];
    in-out property <string> shop-status: "Ready";
    in-out property <bool> shop-is-error: false;
    in-out property <bool> shop-loading: false;

    in-out property <bool> show-delete-confirm: false;
    in-out property <string> delete-pending-label: "";

    in-out property <bool> show-launch-confirm: false;
    in-out property <string> launch-pending-label: "";
    in-out property <string> launch-pending-type: "";  // "riot" or "valorant"

    callback prepare-new-login();
    callback save-session();
    callback switch-account(string);
    callback launch-valorant(string);
    callback delete-account(string);
    callback clean-cache();
    callback refresh-cache();
    callback toggle-cache-entry(int, bool);
    callback open-url(string);
    callback refresh-shop-accounts();
    callback fetch-shop();
    callback minimize-window();
    callback close-window();
    callback move-window(length, length);
    callback resize-window(length, length);

    VerticalLayout {
        spacing: 0px;

        TitleBar {
            minimize => { root.minimize-window(); }
            close => { root.close-window(); }
            move-window(dx, dy) => { root.move-window(dx, dy); }
            toggle-sidebar => { sidebar.expanded = !sidebar.expanded; }
        }

        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            sidebar := Sidebar {
                current-page <=> root.current-page;
                navigate(page) => {
                    root.current-page = page;
                    if (page == "shop") {
                        root.refresh-shop-accounts();
                    }
                    if (page == "cache") {
                        root.refresh-cache();
                    }
                }
            }


            if root.current-page == "accounts": AccountsPage {
                accounts: root.accounts;
                status-message: root.status-message;
                status-is-error: root.status-is-error;
                prepare-new-login => { root.prepare-new-login(); }
                save-session => { root.save-session(); }
                switch-account(label) => {
                    root.launch-pending-label = label;
                    root.launch-pending-type = "riot";
                    root.show-launch-confirm = true;
                }
                launch-valorant(label) => {
                    root.launch-pending-label = label;
                    root.launch-pending-type = "valorant";
                    root.show-launch-confirm = true;
                }
                request-delete(label) => {
                    root.delete-pending-label = label;
                    root.show-delete-confirm = true;
                }
            }

            if root.current-page == "cache": CachePage {
                cache-entries: root.cache-entries;
                cache-size-display: root.cache-size-display;
                cache-status: root.cache-status;
                cache-is-error: root.cache-is-error;
                clean-cache => { root.clean-cache(); }
                toggle-cache-entry(idx, val) => { root.toggle-cache-entry(idx, val); }
            }

            if root.current-page == "shop": ShopPage {
                shop-account-labels: root.shop-account-labels;
                shop-selected-index <=> root.shop-selected-index;
                shop-download-images <=> root.shop-download-images;
                shop-results: root.shop-results;
                shop-status: root.shop-status;
                shop-is-error: root.shop-is-error;
                shop-loading: root.shop-loading;
                fetch-shop => { root.fetch-shop(); }
            }

            if root.current-page == "about": AboutPage {
                open-url(url) => { root.open-url(url); }
            }

        } // HorizontalLayout
    } // VerticalLayout

    // Delete confirmation overlay
    if root.show-delete-confirm: Rectangle {
        background: #000000AA;

        TouchArea {
            clicked => {
                root.show-delete-confirm = false;
            }
        }

        Rectangle {
            width: 320px;
            height: 160px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: Colors.panel;
            border-width: 1px;
            border-color: Colors.border;

            VerticalLayout {
                padding: 20px;
                spacing: 16px;
                alignment: start;

                Text {
                    text: "Delete '" + root.delete-pending-label + "'?";
                    color: Colors.text-primary;
                    font-size: 14px;
                    font-weight: 600;
                }

                Text {
                    text: "This will remove the saved session. This action cannot be undone.";
                    color: Colors.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    VButton {
                        label: "Cancel";
                        horizontal-stretch: 0;
                        clicked => {
                            root.show-delete-confirm = false;
                        }
                    }

                    VButton {
                        label: "Delete";
                        accent: true;
                        horizontal-stretch: 0;
                        clicked => {
                            root.delete-account(root.delete-pending-label);
                            root.show-delete-confirm = false;
                        }
                    }
                }
            }
        }
    }

    // Launch confirmation overlay
    if root.show-launch-confirm: Rectangle {
        background: #000000AA;

        TouchArea {
            clicked => {
                root.show-launch-confirm = false;
            }
        }

        Rectangle {
            width: 360px;
            height: 170px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: Colors.panel;
            border-width: 1px;
            border-color: Colors.border;

            VerticalLayout {
                padding: 20px;
                spacing: 16px;
                alignment: start;

                Text {
                    text: (root.launch-pending-type == "valorant" ? "Launch Valorant" : "Launch Riot Client") + " as '" + root.launch-pending-label + "'?";
                    color: Colors.text-primary;
                    font-size: 14px;
                    font-weight: 600;
                    wrap: word-wrap;
                }

                Text {
                    text: "This will kill any running Riot Client, switch account, and launch.";
                    color: Colors.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    VButton {
                        label: "Cancel";
                        horizontal-stretch: 0;
                        clicked => {
                            root.show-launch-confirm = false;
                        }
                    }

                    VButton {
                        label: root.launch-pending-type == "valorant" ? "Launch Valorant" : "Launch Riot";
                        accent: true;
                        horizontal-stretch: 0;
                        clicked => {
                            if (root.launch-pending-type == "valorant") {
                                root.launch-valorant(root.launch-pending-label);
                            } else {
                                root.switch-account(root.launch-pending-label);
                            }
                            root.show-launch-confirm = false;
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        x: parent.width - 8px;
        y: parent.height - 8px;
        width: 8px;
        height: 8px;

        TouchArea {
            mouse-cursor: nwse-resize;
            moved => {
                if (self.pressed) {
                    root.resize-window(
                        self.mouse-x - self.pressed-x,
                        self.mouse-y - self.pressed-y
                    );
                }
            }
        }
    }

    Rectangle {
        x: parent.width - 4px;
        y: 32px;
        width: 4px;
        height: parent.height - 40px;

        TouchArea {
            mouse-cursor: ew-resize;
            moved => {
                if (self.pressed) {
                    root.resize-window(self.mouse-x - self.pressed-x, 0);
                }
            }
        }
    }

    Rectangle {
        x: 0;
        y: parent.height - 4px;
        width: parent.width - 8px;
        height: 4px;

        TouchArea {
            mouse-cursor: ns-resize;
            moved => {
                if (self.pressed) {
                    root.resize-window(0, self.mouse-y - self.pressed-y);
                }
            }
        }
    }
}
