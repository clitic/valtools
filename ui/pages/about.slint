import { Colors } from "../theme.slint";

export component AboutPage inherits VerticalLayout {
    callback open-url(string);

    spacing: 14px;
    padding: 16px;

    Text {
        text: "ValTools";
        color: Colors.text-primary;
        font-size: 20px;
        font-weight: 700;
    }

    Text {
        text: "v0.1.0";
        color: Colors.accent;
        font-size: 13px;
        font-weight: 600;
    }

    Text {
        text: "A lightweight Valorant toolkit for Windows. Switch between multiple Riot accounts without logging out, view your daily shop offers, and clean cache files.";
        color: Colors.text-secondary;
        font-size: 12px;
        wrap: word-wrap;
    }

    Rectangle {
        height: 1px;
        background: Colors.border;
    }

    Text {
        text: "Links";
        color: Colors.text-primary;
        font-size: 14px;
        font-weight: 600;
    }

    Rectangle {
        height: 44px;
        border-radius: 4px;
        background: link1.has-hover ? Colors.panel-hover : Colors.panel;
        border-width: 1px;
        border-color: link1.has-hover ? Colors.accent : Colors.border;
        animate background { duration: 100ms; }
        animate border-color { duration: 100ms; }

        link1 := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.open-url("https://github.com/clitic/valtools");
            }
        }

        HorizontalLayout {
            padding-left: 14px;
            spacing: 10px;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;

                Image {
                    source: @image-url("../icons/github.svg");
                    width: 20px;
                    height: 20px;
                }
            }

            VerticalLayout {
                alignment: center;

                Text {
                    text: "GitHub Repository";
                    color: Colors.text-primary;
                    font-size: 12px;
                    font-weight: 600;
                }

                Text {
                    text: "github.com/clitic/valtools";
                    color: Colors.text-muted;
                    font-size: 10px;
                }
            }
        }
    }

    Rectangle {
        height: 44px;
        border-radius: 4px;
        background: link2.has-hover ? Colors.panel-hover : Colors.panel;
        border-width: 1px;
        border-color: link2.has-hover ? Colors.accent : Colors.border;
        animate background { duration: 100ms; }
        animate border-color { duration: 100ms; }

        link2 := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.open-url("https://github.com/clitic/valtools/issues");
            }
        }

        HorizontalLayout {
            padding-left: 14px;
            spacing: 10px;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;

                Image {
                    source: @image-url("../icons/triangle-alert.svg");
                    width: 20px;
                    height: 20px;
                }
            }

            VerticalLayout {
                alignment: center;

                Text {
                    text: "Report Issues";
                    color: Colors.text-primary;
                    font-size: 12px;
                    font-weight: 600;
                }

                Text {
                    text: "github.com/clitic/valtools/issues";
                    color: Colors.text-muted;
                    font-size: 10px;
                }
            }
        }
    }

    Rectangle {
        vertical-stretch: 1;
    }
}
